<Project Sdk="Microsoft.NET.Sdk">
  <!-- RimWorld 1.7 harness: same Program.cs as ../Validator, on net10 with Harmony 3 (the version 1.7 requires). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Validator</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS8600;CS8602;CS8604;CS0618;SYSLIB0050</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Validator\Program.cs" />
    <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.3" />
  </ItemGroup>
</Project>
